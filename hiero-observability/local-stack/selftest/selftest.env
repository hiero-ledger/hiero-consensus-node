# Selftest overrides, appended after defaults.env. `local.env` is deliberately
# NOT read: the selftest asserts that the committed defaults work, not that a
# particular developer's configuration does.

# A bare name (no `/` or `.`) is a Compose *named volume*, not a bind mount, so
# the fixture never writes into anyone's working tree and `down -v` reclaims it.
LOGS_DIR=selftest-logs

# Activates the `selftest` scrape job.
SELFTEST_TARGETS=["selftest-metrics:8080"]

# Nothing is listening on :9999 during a selftest; drop the default target so
# the logs are not full of connection failures.
SCRAPE_TARGETS=[]

SCRAPE_INTERVAL=5s
METRIC_LABELS={"environment":"selftest"}
LOG_LABELS={"environment":"selftest"}

# Host port 0 means "any free port". The selftest runs as its own Compose
# project and would otherwise collide with a running stack on every port, and
# port mappings cannot be removed by an override file. The assertions address
# services by name on the Compose network and never use host ports.
GRAFANA_PORT=0
VICTORIAMETRICS_PORT=0
LOKI_PORT=0
ALLOY_PORT=0
