# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  # snappy-java 1.1.10.7 is pulled in transitively by org.hyperledger.besu:besu-evm via
  # besu-util. Snyk records no fixed version for this advisory and there is no GHSA/CVE for
  # it yet, so there is nothing to upgrade to; without this entry the finding fails every
  # build at --severity-threshold=high. Revisit when besu ships a release off 1.1.10.7.
  # Snyk re-issues this advisory under new IDs (previously SNYK-JAVA-ORGXERIALSNAPPY-19778376),
  # and ignores are keyed by ID, so the ID below needs updating whenever that happens.
  SNYK-JAVA-ORGXERIALSNAPPY-19964087:
    - '*':
        reason: No fixed snappy-java version is available at this time (transitive via besu-evm)
        expires: 2026-10-16T00:00:00.000Z
        created: 2026-09-21T00:00:00.000Z
patch: {}
exclude:
  global:
    - >-
      hedera-node/hedera-smart-contract-service-impl/src/main/java/com/hedera/node/app/service/contract/impl/state/DispatchingEvmFrameState.java
    - >-
      hedera-node/test-clients/src/main/java/com/hedera/services/bdd/suites/contract/opcodes/Create2OperationSuite.java
    - >-
      hedera-node/test-clients/src/main/java/com/hedera/services/bdd/spec/keys/deterministic/Bip0032.java
    - >-
      platform-sdk/consensus-otter-docker-app/src/testFixtures/java/org/hiero/consensus/otter/docker/app/DockerManager.java
    - >-
      platform-sdk/consensus-otter-docker-app/src/testFixtures/java/org/hiero/consensus/otter/docker/app/platform/NodeCommunicationService.java
    - >-
      platform-sdk/consensus-sloth/src/testFixtures/java/org/hiero/sloth/fixtures/container/docker/DockerManager.java
    - >-
      platform-sdk/consensus-sloth/src/testFixtures/java/org/hiero/sloth/fixtures/container/docker/platform/NodeCommunicationService.java
    - >-
      platform-sdk/consensus-gossip-impl/src/main/java/org/hiero/consensus/gossip/impl/network/PeerConnectionServer.java