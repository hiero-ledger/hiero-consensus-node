#/usr/bin/sh -f
KBCTL=/home/runner/_work/_tool/kubectl/1.33.0/x64/kubectl.orig


timeout --signal=KILL --preserve-status --foreground 10m $KBCTL "$@" >/tmp/stdout.$$ 2>/tmp/stderr.$$
result=$?
if [ $result -ne 137 ]
then
  grep -E 'Internal error occurred|context deadline exceeded' /tmp/stdout.$$ /tmp/stderr.$$ >/dev/null
  if [ $? -eq 0 ]
  then
    sleep 1
    rm -f /tmp/stdout.$$ /tmp/stderr.$$
    timeout --signal=KILL --preserve-status --foreground 10m $KBCTL "$@"
  else
   cat /tmp/stdout.$$ > /dev/stdout
   cat /tmp/stderr.$$ > /dev/stderr
   rm -f /tmp/stdout.$$ /tmp/stderr.$$
   exit $result
  fi
else
  rm -f /tmp/stdout.$$ /tmp/stderr.$$ 
  timeout --signal=KILL --preserve-status --foreground 10m $KBCTL "$@"
fi
