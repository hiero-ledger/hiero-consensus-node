# SCN-001: two same-round judges on one ancestry chain, with a non-judge strictly between them.
#
# The same graph drawn as it grows - genesis at the bottom, one column per creator, a vertical bar
# for a self-parent edge. A bar passing a layer means that creator made no event at that layer.
# Other-parent edges are not drawn; they are in the rows below, which list the events in creation
# order and so read the other way up from the drawing.
#
#      a          b          c          d
#
#      |          |      c3 (J2)        |      layer 5 - c's first round-2 event, so a round-2 witness
#      |          |          |          |
#      |      b4 (mid)       |          |      layer 4 - round 2 under 'initial', round 3 under 'after'
#      |          |          |          |
#     a3         b3          |         d3      layer 3 - round 2, none of them witnesses
#      |          |          |          |
#     a2      b2 (J1)       c2         d2      layer 2 - a2/b2/d2 are round-2 witnesses;
#      |          |          |          |                c2 is starved and stays in round 1
#     a1         b1         c1         d1      layer 1 - round 1
#      |          |          |          |
#     a0         b0         c0         d0      layer 0 - round 1 witnesses
#
# Why each event lands where it does is derived in Scn001Graph.

kb SCN-001
anchor 2

roster initial  a=1 b=1 c=1 d=1
roster after    a=4 b=1 c=1 d=4

#  name  self  other-parents

# layer 0 - round 1 witnesses
   a0    -     -
   b0    -     -
   c0    -     -
   d0    -     -

# layer 1 - round 1, fully connected
   a1    a0    b0,c0,d0
   b1    b0    a0,c0,d0
   c1    c0    a0,b0,d0
   d1    d0    a0,b0,c0

# layer 2 - a2/b2/d2 are promoted and become round-2 witnesses; c2 takes only a1, which starves
#           it of a supermajority and leaves it in round 1
   a2    a1    b1,c1,d1
   b2    b1    a1,c1,d1
   d2    d1    a1,b1,c1
   c2    c1    a1

# layer 3 - round 2, none of them witnesses. b3 takes no other-parent, which is what keeps b2
#           reachable from b4 through b alone, and therefore never strongly seen
   a3    a2    d2
   b3    b2    -
   d3    d2    a2

# layer 4 - the event the roster change promotes
   b4    b3    a3,d3

# layer 5 - c's first round-2 event, and a descendant of b4
   c3    c2    b4

# layers 6+ - closure: every node takes every other node's latest event, until round 2 decides
   a4    a3    b4,c3,d3
   b5    b4    a3,c3,d3
   c4    c3    a3,b4,d3
   d4    d3    a3,b4,c3
   a5    a4    b5,c4,d4
   b6    b5    a4,c4,d4
   c5    c4    a4,b5,d4
   d5    d4    a4,b5,c4
   a6    a5    b6,c5,d5
   b7    b6    a5,c5,d5
   c6    c5    a5,b6,d5
   d6    d5    a5,b6,c5
   a7    a6    b7,c6,d6
   b8    b7    a6,c6,d6
   c7    c6    a6,b7,d6
   d7    d6    a6,b7,c6
