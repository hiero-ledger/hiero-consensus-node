+// SPDX-License-Identifier: Apache-2.0
+package com.swirlds.merkledb.collections;
+
+import com.swirlds.merkledb.config.MerkleDbConfig;
+import edu.umd.cs.findbugs.annotations.NonNull;
+import java.io.IOException;
+import java.nio.file.Path;
+import org.hiero.base.file.FileSystemManager;
+
+/// Benchmark-only selector for the LongList implementation of all three MerkleDB indices.
+/// The snapshot benchmark campaign applies it as a patch; production code never contains it.
+public enum LongListImplementation {
+    HEAP,
+    OFF_HEAP,
+    SEGMENT,
+    DISK,
+    DISK_SEGMENT;
+
+    /// System property naming the implementation to use instead of the configured one.
+    public static final String SYSTEM_PROPERTY = "merkledb.benchmark.longListImplementation";
+
+    /// Returns the implementation named by [#SYSTEM_PROPERTY], or the one production code would use.
+    ///
+    /// @param preferDiskBasedIndices whether the configuration asks for disk-based indices
+    /// @return the implementation to create or load
+    public static LongListImplementation select(final boolean preferDiskBasedIndices) {
+        final String name = System.getProperty(SYSTEM_PROPERTY);
+        if (name != null) {
+            return valueOf(name);
+        }
+        return preferDiskBasedIndices ? DISK : SEGMENT;
+    }
+
+    /// Creates an empty LongList of this implementation.
+    ///
+    /// @param capacity list capacity
+    /// @param configuration MerkleDB settings
+    /// @param fileSystemManager file system manager for disk-based lists
+    /// @return the new list
+    public LongList create(
+            final long capacity,
+            @NonNull final MerkleDbConfig configuration,
+            @NonNull final FileSystemManager fileSystemManager) {
+        return switch (this) {
+            case HEAP -> new LongListHeap(capacity, configuration);
+            case OFF_HEAP -> new LongListOffHeap(capacity, configuration);
+            case SEGMENT -> new LongListSegment(capacity, configuration);
+            case DISK -> new LongListDisk(capacity, configuration, fileSystemManager);
+            case DISK_SEGMENT -> new LongListDiskSegment(capacity, configuration, fileSystemManager);
+        };
+    }
+
+    /// Loads a LongList of this implementation from a snapshot file.
+    ///
+    /// @param file snapshot file
+    /// @param capacity list capacity
+    /// @param configuration MerkleDB settings
+    /// @param fileSystemManager file system manager for disk-based lists
+    /// @return the loaded list
+    /// @throws IOException if the file cannot be read
+    public LongList load(
+            @NonNull final Path file,
+            final long capacity,
+            @NonNull final MerkleDbConfig configuration,
+            @NonNull final FileSystemManager fileSystemManager)
+            throws IOException {
+        return switch (this) {
+            case HEAP -> new LongListHeap(file, capacity, configuration);
+            case OFF_HEAP -> new LongListOffHeap(file, capacity, configuration);
+            case SEGMENT -> new LongListSegment(file, capacity, configuration);
+            case DISK -> new LongListDisk(file, capacity, configuration, fileSystemManager);
+            case DISK_SEGMENT -> new LongListDiskSegment(file, capacity, configuration, fileSystemManager);
+        };
+    }
+
+    /// Returns whether this implementation keeps its contents in a backing file.
+    ///
+    /// @return true for the disk-based implementations
+    public boolean isDiskBased() {
+        return this == DISK || this == DISK_SEGMENT;
+    }
+}
